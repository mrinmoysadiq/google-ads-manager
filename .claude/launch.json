{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Client (Vite / React)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "client"],
      "port": 3000
    },
    {
      "name": "Server (Express / nodemon)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "server"],
      "port": 5001
    },
    {
      "name": "Full Stack (Client + Server)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    }
  ]
}
